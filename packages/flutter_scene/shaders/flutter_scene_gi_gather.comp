// Gathers each probe's traced rays into one texel of its octahedral tile in
// the irradiance or depth-moment accumulator, the same weighted sums the
// screen-space gather accumulates, so the field's blend reads either feed.
// One invocation per accumulator texel of this frame's scheduled tile rows;
// gutters and unused tiles write zero. A negative ray distance marks a back
// face hit, which counts as black at its (shortened) distance.
//
// Written as packed halves laid out like the `r16g16b16a16Float`
// accumulator, which a buffer-to-texture copy then fills.

layout(local_size_x = 64) in;

layout(std430) buffer;

#include <irradiance_field.glsl>

layout(binding = 0) readonly buffer Rays {
  vec4 data[];
}
rays;

layout(binding = 1) writeonly buffer Texels {
  uvec2 data[];
}
texels;

// This frame's ray directions, shared by every probe.
layout(binding = 2) readonly buffer Directions {
  vec4 data[];
}
directions;

uniform GatherInfo {
  // x: stored tile edge. y: interior edge. z: probe tiles per row. w: 1 for
  // depth moments, 0 for irradiance.
  vec4 region;
  // x: probe count. y: rays per probe. z: accumulator width in texels. w:
  // accumulator texel count.
  vec4 grid;
  // x: the farthest distance a probe records, which normalizes the moments.
  // y: the first texel this dispatch gathers. z: how many.
  vec4 depth;
}
info;

// The depth lobe's sharpness, matching the screen-space gather.
const float kDistanceSharpness = 50.0;

// The cosine below which the depth lobe (cos^50) is under 0.001.
const float kDistanceLobeCutoff = 0.87;

void main() {
  if (gl_GlobalInvocationID.x >= uint(info.depth.z)) {
    return;
  }
  uint index = uint(info.depth.y) + gl_GlobalInvocationID.x;
  if (index >= uint(info.grid.w)) {
    return;
  }
  uint width = uint(info.grid.z);
  vec2 texel = vec2(float(index - (index / width) * width),
                    float(index / width));
  float tile_edge = info.region.x;
  float interior = info.region.y;
  vec2 tile = floor(texel / tile_edge);
  vec2 local = texel - tile * tile_edge;
  float probe = tile.y * info.region.z + tile.x;
  if (probe >= info.grid.x || local.x < 1.0 || local.y < 1.0 ||
      local.x > interior || local.y > interior) {
    texels.data[index] = uvec2(0u);
    return;
  }

  vec2 oct = clamp((local - vec2(0.5)) / interior, 0.0, 1.0);
  vec3 texel_direction = ProbeOctDecode(oct);
  uint ray_count = uint(info.grid.y);
  uint first = uint(probe) * ray_count;
  bool depth = info.region.w > 0.5;
  vec4 sum = vec4(0.0);
  for (uint r = 0u; r < ray_count; r++) {
    float cosine = dot(texel_direction, directions.data[r].xyz);
    if (depth) {
      // The lobe is under a thousandth below this, so skip the fetch.
      if (cosine < kDistanceLobeCutoff) continue;
      float lobe = pow(cosine, kDistanceSharpness);
      float d = min(abs(rays.data[first + r].w) / info.depth.x, 1.0);
      sum += vec4(d * lobe, d * d * lobe, 0.0, lobe);
    } else {
      if (cosine <= 0.0) continue;
      sum += vec4(rays.data[first + r].rgb * cosine, cosine);
    }
  }
  texels.data[index] = uvec2(packHalf2x16(sum.xy), packHalf2x16(sum.zw));
}
